# Copy to .env.local for local development, or set these in your hosting
# provider's dashboard. Never commit real values.

# GitHub account shown on the site. Overrides site.github.username in
# src/content/site.ts. Replace the placeholder with your username.
GITHUB_USERNAME=YOUR_GITHUB_USERNAME

# Optional, server-side only. A fine-grained personal access token with
# "Public repositories (read-only)" access and no other permissions.
# - Raises the GitHub API limit from 60 to 5,000 requests/hour.
# - Lets the contribution calendar come straight from GitHub's GraphQL API
#   instead of the third-party github-contributions-api.jogruber.de mirror.
# Required when running `npm run sync:github`.
GITHUB_TOKEN=

# Public URL of the deployed site, used for canonical links, the sitemap and
# social previews. Vercel sets its own production URL automatically.
NEXT_PUBLIC_SITE_URL=
